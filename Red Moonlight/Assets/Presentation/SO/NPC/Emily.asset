    \u0437\u0430 \u044D\u0442\u043E. \u0421 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
    \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0430 \u0432 \u043D\u0430\u0443\u043A\u0443,
    \u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u044F \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
