  NPCDetails: "\u042D\u043C\u0438\u043B\u0438 \u2014 \u041D\u0430\u0434\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u0432\u0438\u0434\u0430 \u0436\u0435\u043D\u0449\u0438\u043D\u0430, \u0431\u0440\u043E\u0441\u0438\u0432\u0448\u0430\u044F
    \u0432\u044B\u0437\u043E\u0432 \u0432\u0441\u0435\u043C\u0443 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0443
