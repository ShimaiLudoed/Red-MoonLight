  <Image>k__BackingField: {fileID: 21300000, guid: 2a4e54fdadee8be4184be42987c8a56b, type: 3}
  NPCDetails: "\u0427\u0430\u0440\u043B\u044C\u0437 \u2014 \u041F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0438 \u043A\u0440\u0430\u0439\u043D\u0435 \u043D\u0435\u0440\u0432\u043D\u044B\u0439
    \u043C\u0443\u0436\u0447\u0438\u043D\u0430, \u043F\u043E\u0432\u0438\u0434\u0430\u0432\u0448\u0438\u0439
    \u043D\u0430 \u0441\u0432\u043E\u0435\u043C \u043F\u0443\u0442\u0438 \u043D\u0435\u043C\u0430\u043B\u043E.
    \u0411\u043E\u0438\u0442\u0441\u044F \u0447\u0443\u0436\u0438\u0445 \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u0438\u0439
    \u0438 \u0433\u0440\u044F\u0437\u0438. \u042F\u0432\u043D\u043E \u0437\u043D\u0430\u0435\u0442
    \u0442\u043E\u043B\u043A \u0432 \u0432\u044B\u043F\u0438\u0432\u043A\u0435 \u0438
    \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0445 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430\u0445,
    \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0443 \u043E\u0431\u044B\u0447\u043D\u044B\u0445
    \u043B\u044E\u0434\u0435\u0439 \u0441\u0434\u0430\u044E\u0442 \u043D\u0435\u0440\u0432\u044B."
