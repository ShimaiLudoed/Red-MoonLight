  NPCDetails: "\u0412\u0438\u043A\u0442\u043E\u0440 \u2014 \u0424\u043B\u0435\u0433\u043C\u0430\u0442\u0438\u0447\u043D\u044B\u0439
    \u0434\u043E\u043A\u0442\u043E\u0440, \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0438\u0439
    \u0432\u043A\u0443\u0441 \u043A \u0436\u0438\u0437\u043D\u0438 \u0435\u0449\u0435
    \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435. \u0412\u0441\u0435, \u0447\u0442\u043E
    \u043C\u043E\u0436\u0435\u0442 \u0435\u0433\u043E \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u0442\u044C
    \u2014 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445
    \u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B \u043E \u0440\u0430\u0431\u043E\u0442\u0435,
    \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439, \u0432\u043F\u0440\u043E\u0447\u0435\u043C,
    \u043E\u043D \u043D\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F."
